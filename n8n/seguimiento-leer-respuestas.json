    {
      "parameters": {
        "jsCode": "// Decide si un correo entrante es la RESPUESTA de un lead.\n//\n// Arreglado el 28-sep-2026. Antes:\n//  - si no se podia leer el remitente, fromEmail quedaba en '' y casaba con\n//    el primer lead SIN email: movia un lead al azar;\n//  - cualquier correo contaba: autorespuestas, rebotes, lo nuestro propio;\n//  - no miraba la etapa: devolvia a «Respondió» leads en propuesta o perdidos.\nconst leads = $json.leads || [];\nconst fromRaw = $json.from || '';\nconst m = fromRaw.match(/<([^>]+)>/);\nconst fromEmail = (m ? m[1] : fromRaw).trim().toLowerCase();\nconst subject = $json.subject || '';\nconst textPlain = $json.textPlain || '';\n\n// Etapas desde las que un correo puede subir el lead a «Respondió». Más\n// arriba (reunión, propuesta...) ya respondió; ganado/perdido está cerrado.\nconst ETAPAS_QUE_SUBEN = ['nuevo', 'contactado', 'seguimiento'];\n\nconst REMITENTE_AUTOMATICO = /(mailer-daemon|postmaster|no-?reply|donotreply|do-not-reply|bounce|notifications?@)/i;\nconst ASUNTO_AUTOMATICO = /^(auto(matic)? ?reply|auto:|respuesta autom|out of (the )?office|fuera de (la )?oficina|ausente|undeliverable|undelivered|delivery status notification|mail delivery (failed|subsystem)|returned mail|no entregado)/i;\n\nlet motivo = '';\nlet idLead = '';\nif (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(fromEmail)) motivo = 'remitente ilegible';\nelse if (fromEmail.endsWith('@jddeveloper.com')) motivo = 'correo propio';\nelse if (REMITENTE_AUTOMATICO.test(fromEmail) || ASUNTO_AUTOMATICO.test(subject.trim())) motivo = 'correo automatico';\nelse {\n  for (const lead of leads) {\n    const ecList = (lead.email_contacto || '').split(',').map(e => e.trim().toLowerCase()).filter(Boolean);\n    const email = (lead.email || '').trim().toLowerCase();\n    if ((email && email === fromEmail) || ecList.includes(fromEmail)) {\n      if (ETAPAS_QUE_SUBEN.includes(lead.estado)) idLead = lead.id;\n      else motivo = 'lead ya en ' + lead.estado;\n      break;\n    }\n  }\n}\n\nconst dateRaw = $json.date || '';\nconst dt = new Date(dateRaw);\nconst fecha = isNaN(dt.getTime()) ? dateRaw : dt.toISOString();\n\nreturn { json: {\n  matched: !!idLead,\n  idLead,\n  motivo,\n  remitente: fromRaw.trim(),\n  fromEmail,\n  subject,\n  textPlain,\n  fecha\n} };",
        "mode": "runOnceForEachItem"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1400,
        180
      ],
      "id": "seg-matchear",
      "name": "Matchear Lead",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "seg-if-match-c1",
              "leftValue": "={{ $json.matched }}",
              "rightValue": true,
              "operator": {
